# Ключи пакета «Контент на вайбе».
# Провижнер спросит их у тебя при установке и запишет сам — руками файл трогать не нужно.
# Этот файл — просто справка, какие ключи бывают.

# ОБЯЗАТЕЛЬНЫЙ — поиск трендов на YouTube. Как получить: keys-guide/youtube-api-key.md
YOUTUBE_API_KEY=

# ОПЦИОНАЛЬНЫЕ (можно не заполнять):

# Транскрибация своих записей (Whisper) и чистка чужих транскриптов. keys-guide/openai-api-key.md
OPENAI_API_KEY=

# Альтернативная транскрибация, если у тебя уже есть ключ Deepgram
DEEPGRAM_API_KEY=

# Чистка транскриптов через OpenRouter вместо OpenAI
OPENROUTER_API_KEY=
